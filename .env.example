# ==========================================
# WeShare Root Environment Template (.env.example)
# Copy this file to .env and adjust your secrets
# ==========================================

# Application Environment
NODE_ENV=production
APP_NAME=WeShare

# Nginx Gateway Port (Port on host machine)
NGINX_PORT=80

# WeShare API & Worker
API_PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:5173

# Database (PostgreSQL 16)
POSTGRES_DB=weshare_db
POSTGRES_USER=weshare_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
DB_SSL=false

# Cache & Real-time (Redis 7)
REDIS_PORT=6379
REDIS_PASSWORD=

# Message Broker (RabbitMQ 3.13)
RABBITMQ_DEFAULT_USER=weshare
RABBITMQ_DEFAULT_PASS=weshare_secret
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=weshare.topic
RABBITMQ_DLX=weshare.dlx

# Search Engine (Meilisearch 1.8)
MEILI_PORT=7700
MEILI_MASTER_KEY=
MEILI_ENV=development
MEILI_NO_ANALYTICS=true

# Authentication & JWT
JWT_ACCESS_SECRET=super_secret_jwt_access_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/github/callback

# Transactional Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@weshare.local

# Supabase Storage S3 Compatible API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
S3_REGION=global
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_BUCKET_NAME=weshare-media
